  "root_cause_autopsies_and_resolutions": [
    {
      "component": "infrastructure/ec2/dual_cluster_ips",
      "issue": "SSH connection timed out on [REDACTED_AWS_INTEL_IP_2] and [REDACTED_AWS_GRAVITON_IP]",
      "root_cause": "AWS EC2 instances were power-cycled, releasing previous dynamic public IPs and reassigning new network interfaces.",
      "resolution": "Queried AWS EC2 API using profile [REDACTED_AWS_PROFILE] in ap-south-1, discovered updated test addresses, verified direct SSH connectivity, and updated deployment harnesses.",
      "status": "PERMANENTLY_RESOLVED"
    },
    {
      "component": "lethe/pkg/nvmepass/nvme_linux.go",
      "issue": "EBADF: bad file descriptor during consecutive test execution",
      "root_cause": "OpenLinuxNVMe called os.NewFile(uintptr(fd), path) but Close() called syscall.Close(d.fd) instead of d.file.Close(). The Go runtime finalizer on the unclosed os.File remained active. In the subsequent test, the Linux kernel reallocated the exact same file descriptor (fd=3). When garbage collection ran during a 16MB slice allocation, the finalizer from the previous test closed fd=3, causing syscall.Pwrite to fail with EBADF.",
      "resolution": "Updated Close() to invoke d.file.Close(), clearing the Go runtime finalizer and preventing file descriptor recycling collisions.",
      "status": "PERMANENTLY_RESOLVED"
    },
    {
      "component": "lethe/go.mod",
      "issue": "Go 1.22 stdlib incompatibility on ARM64 Graviton4",
      "root_cause": "Ubuntu default repository provided go1.22.2, which lacked stdlib iter and crypto/pbkdf2 required by parquet-go and pgx/v5.",
      "resolution": "Installed Go 1.23.4 on the Graviton4 instance, enabling automatic toolchain resolution to go1.26.10 (linux/arm64).",
      "status": "PERMANENTLY_RESOLVED"
    },
    {
      "component": "db-bastion/proxy_auth",
      "issue": "PostgreSQL 16 pg_hba.conf loopback scram-sha-256 password prompt stalling automation",
      "root_cause": "Default PostgreSQL 16 on Ubuntu enforces scram-sha-256 for loopback TCP connections on port 5432, causing psql CLI to block on stdin for password input.",
      "resolution": "Spawned isolated ephemeral PostgreSQL cluster on port 54328 using initdb --auth=trust via sudo -u postgres, allowing 100% non-interactive, isolated evaluation without touching production credentials.",
      "status": "PERMANENTLY_RESOLVED"
    },
    {
      "component": "sockpool/cmd/main.go",
      "issue": "Flag provided but not defined: -target on sockpool run",
      "root_cause": "sockpool run uses --upstream for database target address, whereas sockpool bench uses --target for the pooler address.",
      "resolution": "Updated benchmark harness to pass --upstream to daemon and --target to benchmark client.",
      "status": "PERMANENTLY_RESOLVED"
    },
    {
      "component": "hookq/pkg/server/server.go",
      "issue": "404 page not found on /api/v1/endpoints",
      "root_cause": "hookq ServeMux routes were registered at /v1/endpoints and /v1/publish without the /api prefix.",
      "resolution": "Updated ingestion benchmark to target canonical /v1/endpoints and /v1/publish.",
      "status": "PERMANENTLY_RESOLVED"
    },
    {
      "component": "infrastructure/ec2/c8i.large",
      "issue": "SSH connection timed out on [REDACTED_AWS_INTEL_IP]",
      "root_cause": "The c8i.large instance was rebooted/power-cycled when enabling AWS Intel nested virtualization, releasing its original dynamic public IP.",
      "resolution": "Queried AWS EC2 API for instance i-0d80828ce706abae6, discovered new network IP, and updated orchestration harnesses.",
      "status": "PERMANENTLY_RESOLVED"
    }
